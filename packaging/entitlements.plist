<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements for the hardened runtime, required to notarize a PyInstaller build. -->

    <!-- CPython allocates executable memory for its bytecode evaluator and ctypes trampolines. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Deliberately absent: disable-library-validation and allow-dyld-environment-variables.
         Library validation already accepts the bundled libpython and C extensions, because
         build_release.sh signs every one with the same Team ID as the executable; and the
         PyInstaller bootloader resolves them via @rpath, not DYLD_* variables. Either
         entitlement would let another process inject a dylib into a binary that runs as root
         and may hold Full Disk Access, i.e. borrow its TCC grants. -->
</dict>
</plist>
