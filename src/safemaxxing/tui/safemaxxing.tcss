/* safemaxxing dashboard.

   One accent marks what works and what you can act on. Severity colours live only in the
   badges (badges.py), so a calm screen means nothing needs you. Paranoia Mode turns the frame
   red, steadily: nothing on this screen blinks.

   Every $sm-* variable comes from the Textual theme app.py builds from palette.py (dark, high
   contrast, light), so this file holds no colour of its own and T recolours all of it. The
   built-in widgets (footer, tabs, toasts, cursor) take their colours from the same theme. */

Screen {
    background: $sm-bg;
    color: $sm-text;
}

/* Top: the verdict in words. */

#posture {
    height: 1;
    padding: 0 1;
    background: $sm-surface;
}

#body {
    height: 1fr;
    padding: 0 0 0 0;
}

#main {
    width: 1fr;
}

/* Fixed width: the feed's cut columns (app.py) are sized to fill the rest at ~170 columns. */
#side {
    width: 50;
}

/* Panes: thin lines, quiet titles; the one you are in takes the accent. */

.pane, #detail-tabs {
    background: $sm-surface;
    border: round $sm-line;
    border-title-color: $sm-muted;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
    padding: 0 1;
}

.pane:focus-within, #detail-tabs:focus-within {
    border: round $sm-accent;
    border-title-color: $sm-accent;
}

#detail-tabs {
    padding: 0;
}

#feed-pane {
    height: 2fr;
}

#detail-tabs {
    height: 1fr;
}

#mode {
    height: auto;
}

#firewall {
    height: auto;
}

#inspector {
    height: 1fr;
}

/* The feed with nothing in it says so, instead of an empty grid. */

#feed-empty {
    display: none;
    padding: 1 1;
}

#feed-pane.-empty #feed {
    height: auto;
}

#feed-pane.-empty #feed-empty {
    display: block;
    height: 1fr;
}

#filter {
    display: none;
    height: 3;
    background: $sm-bg;
    border: tall $sm-accent;
    margin-bottom: 1;
}

#filter.-open {
    display: block;
}

DataTable {
    height: 1fr;
    background: $sm-surface;
    scrollbar-size-vertical: 1;
}

/* No lighter box inside the pane when the table has focus: the border already says so. */
DataTable:focus,
DataTable:focus > .datatable--header {
    background-tint: $sm-surface 0%;
}

DataTable > .datatable--header {
    background: $sm-surface;
    color: $sm-muted;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $sm-hover;
}

RichLog {
    background: $sm-surface;
    scrollbar-size-vertical: 1;
}

TabPane {
    padding: 0 1;
}

Tabs {
    background: $sm-surface;
}

#status {
    height: 1;
    background: $sm-bg;
    color: $sm-text;
    padding: 0 1;
}

/* Paranoia Mode card and its button: a deliberate control, red only in its words until on. */

#mode-text {
    height: auto;
}

#panic {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    border: none;
    content-align: center middle;
    background: $sm-raised;
    color: $sm-danger;
    text-style: bold;
}

#panic:hover {
    background: $sm-panic-hover;
    text-style: bold;
}

/* Focus is always visible: the focused control is drawn in reverse, not only tinted. */
Button:focus, #panic:focus {
    text-style: bold reverse;
}

/* Scrollable text (the sensor log, the help) shows its focus by its frame. */
RichLog:focus {
    background-tint: $sm-accent 4%;
}

#panic:disabled {
    color: $sm-muted;
    background: $sm-raised;
}

/* Modal screens */

ConfirmScreen, TimelineScreen, HelpScreen, CopyScreen {
    align: center middle;
    background: $sm-bg 75%;
}

#dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-danger;
}

#dialog Label {
    width: 100%;
}

#dialog .question {
    color: $sm-strong;
    text-style: bold;
}

#dialog .detail {
    color: $sm-muted;
    margin-top: 1;
}

#buttons {
    height: auto;
    margin-top: 1;
}

#buttons .hint {
    width: 1fr;
    color: $sm-muted;
    padding-top: 1;
}

#buttons Button {
    margin-left: 1;
}

#timeline {
    width: 90%;
    max-width: 140;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-accent;
    border-title-color: $sm-accent;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
}

/* Paranoia Mode on: the frame turns red and stays red. No timer, no blinking. */

Screen.-lockdown {
    background: $sm-lockdown-bg;
}

Screen.-lockdown #posture {
    background: $sm-lockdown-bar;
}

Screen.-lockdown .pane,
Screen.-lockdown #detail-tabs {
    border: round $sm-danger;
    border-title-color: $sm-danger;
}

Screen.-lockdown #panic {
    background: $sm-panic-fill;
    color: $sm-panic-ink;
}

Screen.-lockdown #panic:hover, Screen.-lockdown #panic:focus {
    background: $sm-panic-fill-hover;
}

/* Help and copy dialogs: framed in the accent, like the timeline. */

#help {
    width: 90%;
    max-width: 110;
    height: 85%;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-accent;
    border-title-color: $sm-accent;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
}

#copy {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-accent;
    border-title-color: $sm-accent;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
}

#copy-options {
    height: auto;
    max-height: 16;
    background: $sm-surface;
    border: none;
}

/* Narrower terminals (app.py HORIZONTAL_BREAKPOINTS): -wide from 150 columns, -medium from
   110, -narrow below. Medium narrows the side column; narrow puts the three side panels in a
   row under the feed, so the alert table keeps the full width. */

Screen.-medium #side {
    width: 40;
}

Screen.-narrow #body {
    layout: vertical;
}

Screen.-narrow #main {
    height: 2fr;
}

Screen.-narrow #side {
    width: 100%;
    height: 1fr;
    min-height: 10;
    layout: horizontal;
}

Screen.-narrow #side > .pane {
    width: 1fr;
    height: 100%;
}

Screen.-narrow #panic {
    height: 1;
    margin: 0;
}
