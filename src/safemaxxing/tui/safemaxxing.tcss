/* safemaxxing dashboard: deep dark background, thin rounded borders, cyan focus accent.
   Badge colours live in badges.py; keep the two palettes in step. */

Screen {
    background: #0a0e14;
    color: #c5cdd9;
}

Header {
    background: #0f111a;
    color: #56b6c2;
    text-style: bold;
}

Footer {
    background: #0a0e14;
}

#body {
    height: 1fr;
}

#main {
    width: 1fr;
}

/* Fixed width: the feed's cut columns (app.py) are sized to fill the rest at ~170 columns. */
#side {
    width: 50;
}

.pane {
    background: #0f111a;
    border: round #3e4451;
    border-title-color: #56b6c2;
    border-title-style: bold;
    border-subtitle-color: #5c6370;
    padding: 0 1;
}

.pane:focus-within {
    border: round #56b6c2;
}

#feed-pane {
    height: 2fr;
}

#detail-tabs {
    height: 1fr;
    background: #0f111a;
    border: round #3e4451;
}

#detail-tabs:focus-within {
    border: round #56b6c2;
}

#firewall {
    height: auto;
}

#inspector {
    height: 1fr;
}

#filter {
    display: none;
    height: 3;
    background: #0a0e14;
    border: tall #56b6c2;
    margin-bottom: 1;
}

#filter.-open {
    display: block;
}

DataTable {
    height: 1fr;
    background: #0f111a;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: #0f111a;
    color: #5c6370;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1c2333;
}

DataTable:focus > .datatable--cursor {
    background: #263040;
    text-style: none;
}

DataTable > .datatable--hover {
    background: #151a24;
}

RichLog {
    background: #0f111a;
    scrollbar-size-vertical: 1;
}

TabPane {
    padding: 0 1;
}

#status {
    height: 1;
    background: #0f111a;
    color: #c5cdd9;
    padding: 0 1;
}

/* Modal screens */

ConfirmScreen, TimelineScreen {
    align: center middle;
    background: #0a0e14 70%;
}

#dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: #0f111a;
    border: round #e06c75;
}

#dialog .hint {
    color: #5c6370;
}

#buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

#buttons Button {
    margin-left: 1;
}

#timeline {
    width: 90%;
    max-width: 140;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #0f111a;
    border: round #ff2e88;
    border-title-color: #ff2e88;
    border-title-style: bold;
    border-subtitle-color: #5c6370;
}
