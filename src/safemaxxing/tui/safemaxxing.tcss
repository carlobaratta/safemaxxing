/* safemaxxing dashboard.

   One accent, the project's teal, marks what works and what you can act on. Severity colours
   live only in the badges (badges.py), so a calm screen means nothing needs you. Paranoia Mode
   turns the frame red, steadily: nothing on this screen blinks.

   palette.py holds the same values for the Rich renderables; keep the two in step. The
   built-in widgets (footer, tabs, toasts, cursor) take theirs from the theme in app.py. */

$sm-bg: #0a0e14;
$sm-surface: #0e131b;
$sm-raised: #161d28;
$sm-line: #222b38;
$sm-text: #cfd7e2;
$sm-strong: #eef2f6;
$sm-muted: #7a8595;
$sm-accent: #56b6c2;
$sm-danger: #ff2e4d;

Screen {
    background: $sm-bg;
    color: $sm-text;
}

/* Top: the verdict in words. */

#posture {
    height: 1;
    padding: 0 1;
    background: $sm-surface;
}

#body {
    height: 1fr;
    padding: 0 0 0 0;
}

#main {
    width: 1fr;
}

/* Fixed width: the feed's cut columns (app.py) are sized to fill the rest at ~170 columns. */
#side {
    width: 50;
}

/* Panes: thin lines, quiet titles; the one you are in takes the accent. */

.pane, #detail-tabs {
    background: $sm-surface;
    border: round $sm-line;
    border-title-color: $sm-muted;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
    padding: 0 1;
}

.pane:focus-within, #detail-tabs:focus-within {
    border: round $sm-accent;
    border-title-color: $sm-accent;
}

#detail-tabs {
    padding: 0;
}

#feed-pane {
    height: 2fr;
}

#detail-tabs {
    height: 1fr;
}

#mode {
    height: auto;
}

#firewall {
    height: auto;
}

#inspector {
    height: 1fr;
}

/* The feed with nothing in it says so, instead of an empty grid. */

#feed-empty {
    display: none;
    padding: 1 1;
}

#feed-pane.-empty #feed {
    height: auto;
}

#feed-pane.-empty #feed-empty {
    display: block;
    height: 1fr;
}

#filter {
    display: none;
    height: 3;
    background: $sm-bg;
    border: tall $sm-accent;
    margin-bottom: 1;
}

#filter.-open {
    display: block;
}

DataTable {
    height: 1fr;
    background: $sm-surface;
    scrollbar-size-vertical: 1;
}

/* No lighter box inside the pane when the table has focus: the border already says so. */
DataTable:focus,
DataTable:focus > .datatable--header {
    background-tint: $sm-surface 0%;
}

DataTable > .datatable--header {
    background: $sm-surface;
    color: $sm-muted;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #131a24;
}

RichLog {
    background: $sm-surface;
    scrollbar-size-vertical: 1;
}

TabPane {
    padding: 0 1;
}

Tabs {
    background: $sm-surface;
}

#status {
    height: 1;
    background: $sm-bg;
    color: $sm-text;
    padding: 0 1;
}

/* Paranoia Mode card and its button: a deliberate control, red only in its words until on. */

#mode-text {
    height: auto;
}

#panic {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    border: none;
    content-align: center middle;
    background: $sm-raised;
    color: $sm-danger;
    text-style: bold;
}

#panic:hover, #panic:focus {
    background: #2a0d14;
    text-style: bold;
}

#panic:disabled {
    color: $sm-muted;
    background: $sm-raised;
}

/* Modal screens */

ConfirmScreen, TimelineScreen {
    align: center middle;
    background: $sm-bg 75%;
}

#dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-danger;
}

#dialog Label {
    width: 100%;
}

#dialog .question {
    color: $sm-strong;
    text-style: bold;
}

#dialog .detail {
    color: $sm-muted;
    margin-top: 1;
}

#buttons {
    height: auto;
    margin-top: 1;
}

#buttons .hint {
    width: 1fr;
    color: $sm-muted;
    padding-top: 1;
}

#buttons Button {
    margin-left: 1;
}

#timeline {
    width: 90%;
    max-width: 140;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $sm-surface;
    border: round $sm-accent;
    border-title-color: $sm-accent;
    border-title-style: bold;
    border-subtitle-color: $sm-muted;
}

/* Paranoia Mode on: the frame turns red and stays red. No timer, no blinking. */

Screen.-lockdown {
    background: #10070a;
}

Screen.-lockdown #posture {
    background: #5c0012;
}

Screen.-lockdown .pane,
Screen.-lockdown #detail-tabs {
    border: round $sm-danger;
    border-title-color: $sm-danger;
}

Screen.-lockdown #panic {
    background: $sm-danger;
    color: #ffffff;
}

Screen.-lockdown #panic:hover, Screen.-lockdown #panic:focus {
    background: #d81e3c;
}
